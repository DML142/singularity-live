{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Minimal capability set for the Singularity Live main window.",
  "windows": ["main"],
  "permissions": [
    "allow-get-app-status",
    "allow-get-manual-assistance-readiness",
    "allow-start-manual-assistance",
    "allow-cancel-manual-assistance",
    "allow-reset-session",
    "allow-get-screen-capture-capabilities",
    "allow-list-screen-capture-targets",
    "allow-start-screen-capture",
    "allow-capture-screen-from-ui",
    "allow-cancel-ui-screen-capture",
    "allow-cancel-screen-capture",
    "allow-crop-screen-capture",
    "allow-discard-screen-capture",
    "allow-start-screenshot-assistance",
    "allow-get-shortcut-bindings",
    "allow-update-shortcut-bindings",
    "allow-get-window-opacity",
    "allow-set-window-opacity",
    "allow-get-app-scale",
    "allow-set-app-scale",
    "allow-get-screenshot-preferences",
    "allow-set-screenshot-preferences",
    "allow-get-user-context-files",
    "allow-add-user-context-files",
    "allow-remove-user-context-file",
    "allow-get-provider-settings",
    "allow-save-provider-profile",
    "allow-open-provider-settings-file",
    "allow-set-voice-input-source",
    "allow-list-audio-input-devices",
    "allow-get-voice-input-settings",
    "allow-start-voice-input",
    "allow-stop-voice-input",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
